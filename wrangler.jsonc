{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "radiant-optimizer-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Matches the live host: /page.html and /page/ serve as /page,
    // /dir/index.html and /dir serve as /dir/. The worker upgrades
    // those redirects from 307 to 301.
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "radiantoptimizerlist.com", "custom_domain": true },
    { "pattern": "www.radiantoptimizerlist.com", "custom_domain": true }
  ]
}
